// Permite al usuario de sistema 'nftguard' arrancar/parar/reiniciar únicamente
// wg-quick@wg0.service (ver app/services/wireguard_service.py). El backend corre
// sin privilegios de root (deploy/systemd/nftguard-backend.service).
polkit.addRule(function (action, subject) {
  if (subject.user !== "nftguard") {
    return polkit.Result.NOT_HANDLED;
  }

  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "wg-quick@wg0.service"
  ) {
    return polkit.Result.YES;
  }

  return polkit.Result.NOT_HANDLED;
});
