// Permite al usuario de sistema 'nftguard' arrancar/parar/reiniciar únicamente
// suricata.service, y recargar systemd tras escribir el override de ExecStart
// (ver app/services/suricata_service.py). Sin esto, el backend (que corre sin
// privilegios de root, ver deploy/systemd/nftguard-backend.service) no podría
// controlar el servicio.
polkit.addRule(function (action, subject) {
  if (subject.user !== "nftguard") {
    return polkit.Result.NOT_HANDLED;
  }

  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "suricata.service"
  ) {
    return polkit.Result.YES;
  }

  if (action.id === "org.freedesktop.systemd1.reload-daemon") {
    return polkit.Result.YES;
  }

  return polkit.Result.NOT_HANDLED;
});
